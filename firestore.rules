rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validFriendCode(code) {
      return code is string && code.matches('^[A-Z0-9]{6}$');
    }

    function validProfileFields(data) {
      return data.get('icon', '') is string
        && data.get('icon', '') in [
          '', '📚', '✏️', '🎯', '🔥', '⭐️', '🚀', '🐱', '🐶', '🦊', '🐼',
          '🦁', '🐸', '🍀', '🌟', '⚡️', '🎓', '🧠', '🏆', '🎮', '🍩'
        ]
        && data.get('bio', '') is string
        && data.get('bio', '').size() <= 140;
    }

    function validFriendDocument(friendUid, data) {
      return data.keys().hasOnly(['nickname', 'friendCode', 'addedAt', 'icon', 'bio'])
        && data.nickname == get(/databases/$(database)/documents/users/$(friendUid)).data.nickname
        && data.friendCode == get(/databases/$(database)/documents/users/$(friendUid)).data.friendCode
        && data.get('icon', '') == get(/databases/$(database)/documents/users/$(friendUid)).data.get('icon', '')
        && data.get('bio', '') == get(/databases/$(database)/documents/users/$(friendUid)).data.get('bio', '')
        && data.addedAt is timestamp
        && validFriendCode(data.friendCode)
        && validProfileFields(data);
    }

    function acceptsFriendRequest(receiverUid, senderUid) {
      return signedIn()
        && request.auth.uid == receiverUid
        && exists(/databases/$(database)/documents/users/$(receiverUid)/friendRequests/$(senderUid))
        && !existsAfter(/databases/$(database)/documents/users/$(receiverUid)/friendRequests/$(senderUid))
        && existsAfter(/databases/$(database)/documents/users/$(receiverUid)/friends/$(senderUid))
        && existsAfter(/databases/$(database)/documents/users/$(senderUid)/friends/$(receiverUid));
    }

    function removesMutualFriend(removerUid, otherUid) {
      return signedIn()
        && request.auth.uid == removerUid
        && !existsAfter(/databases/$(database)/documents/users/$(removerUid)/friends/$(otherUid))
        && !existsAfter(/databases/$(database)/documents/users/$(otherUid)/friends/$(removerUid));
    }

    function validUserDocument(uid) {
      return request.resource.data.keys().hasOnly(['nickname', 'friendCode', 'createdAt', 'icon', 'bio'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 30
        && validFriendCode(request.resource.data.friendCode)
        && validProfileFields(request.resource.data)
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == uid;
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid) && validUserDocument(uid);
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/friendCodes/$(resource.data.friendCode));

      match /friends/{friendUid} {
        allow get: if isOwner(uid) || (signedIn() && request.auth.uid == friendUid);
        allow list: if isOwner(uid);
        allow create, update: if signedIn()
          && friendUid != uid
          && validFriendDocument(friendUid, request.resource.data)
          && (acceptsFriendRequest(uid, friendUid) || acceptsFriendRequest(friendUid, uid));
        allow delete: if (isOwner(uid)
            && (!exists(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid))
              || removesMutualFriend(uid, friendUid)))
          || (signedIn() && request.auth.uid == friendUid && removesMutualFriend(friendUid, uid));
      }

      match /friendRequests/{senderUid} {
        allow get: if isOwner(uid) || (signedIn() && request.auth.uid == senderUid);
        allow list: if isOwner(uid);
        allow create: if signedIn()
          && request.auth.uid == senderUid
          && uid != senderUid
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.keys().hasOnly([
            'fromUID', 'fromNickname', 'fromFriendCode', 'createdAt'
          ])
          && request.resource.data.fromUID == senderUid
          && request.resource.data.fromNickname
            == get(/databases/$(database)/documents/users/$(senderUid)).data.nickname
          && request.resource.data.fromFriendCode
            == get(/databases/$(database)/documents/users/$(senderUid)).data.friendCode
          && request.resource.data.createdAt == request.time
          && (!exists(/databases/$(database)/documents/users/$(uid)/friends/$(senderUid))
            || !exists(/databases/$(database)/documents/users/$(senderUid)/friends/$(uid)))
          && !exists(/databases/$(database)/documents/users/$(senderUid)/friendRequests/$(uid));
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /invites/{inviteId} {
        allow read, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['roomCode', 'fromUID', 'fromNickname', 'createdAt'])
          && request.resource.data.fromUID == request.auth.uid
          && request.resource.data.fromNickname is string
          && request.resource.data.roomCode is string
          && request.resource.data.roomCode.matches('^[0-9]{4}$')
          && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid));
        allow update: if false;
      }
    }

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validFriendCode(code)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendCode == code;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
