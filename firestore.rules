rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validFriendCode(code) {
      return code is string && code.matches('^[A-Z0-9]{6}$');
    }

    function validProfileFields(data) {
      return data.get('icon', '') is string
        && data.get('icon', '') in [
          '', '📚', '✏️', '🎯', '🔥', '⭐️', '🚀', '🐱', '🐶', '🦊', '🐼',
          '🦁', '🐸', '🍀', '🌟', '⚡️', '🎓', '🧠', '🏆', '🎮', '🍩'
        ]
        && data.get('bio', '') is string
        && data.get('bio', '').size() <= 140;
    }

    function validFriendDocument(friendUid, data) {
      return data.keys().hasOnly(['nickname', 'friendCode', 'addedAt', 'icon', 'bio'])
        && data.nickname == get(/databases/$(database)/documents/users/$(friendUid)).data.nickname
        && data.friendCode == get(/databases/$(database)/documents/users/$(friendUid)).data.friendCode
        && data.get('icon', '') == get(/databases/$(database)/documents/users/$(friendUid)).data.get('icon', '')
        && data.get('bio', '') == get(/databases/$(database)/documents/users/$(friendUid)).data.get('bio', '')
        && data.addedAt is timestamp
        && validFriendCode(data.friendCode)
        && validProfileFields(data);
    }

    function acceptsFriendRequest(receiverUid, senderUid) {
      return signedIn()
        && request.auth.uid == receiverUid
        && exists(/databases/$(database)/documents/users/$(receiverUid)/friendRequests/$(senderUid))
        && !existsAfter(/databases/$(database)/documents/users/$(receiverUid)/friendRequests/$(senderUid))
        && !existsAfter(/databases/$(database)/documents/users/$(senderUid)/sentFriendRequests/$(receiverUid))
        && existsAfter(/databases/$(database)/documents/users/$(receiverUid)/friends/$(senderUid))
        && existsAfter(/databases/$(database)/documents/users/$(senderUid)/friends/$(receiverUid));
    }

    function removesFriendRequestPair(receiverUid, senderUid) {
      return signedIn()
        && request.auth.uid == receiverUid
        && !existsAfter(/databases/$(database)/documents/users/$(receiverUid)/friendRequests/$(senderUid))
        && !existsAfter(/databases/$(database)/documents/users/$(senderUid)/sentFriendRequests/$(receiverUid));
    }

    function removesMutualFriend(removerUid, otherUid) {
      return signedIn()
        && request.auth.uid == removerUid
        && !existsAfter(/databases/$(database)/documents/users/$(removerUid)/friends/$(otherUid))
        && !existsAfter(/databases/$(database)/documents/users/$(otherUid)/friends/$(removerUid));
    }

    function validUserDocument(uid) {
      return request.resource.data.keys().hasOnly(['nickname', 'friendCode', 'createdAt', 'icon', 'bio'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 30
        && validFriendCode(request.resource.data.friendCode)
        && validProfileFields(request.resource.data)
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == uid;
    }

    function mutualFriends(senderUid, recipientUid) {
      return existsAfter(/databases/$(database)/documents/users/$(senderUid)/friends/$(recipientUid))
        && existsAfter(/databases/$(database)/documents/users/$(recipientUid)/friends/$(senderUid));
    }

    function validInviteIdentity(recipientUid, inviteId, data) {
      return data.roomInstanceID is string
        && data.roomInstanceID.size() >= 1
        && data.roomInstanceID.size() <= 128
        && data.roomInstanceID.matches('^[A-Za-z0-9-]+$')
        && data.roomCode is string
        && data.roomCode.matches('^[0-9]{4}$')
        && data.fromUID is string
        && data.toUID is string
        && data.toUID == recipientUid
        && inviteId == data.roomInstanceID + '_' + data.fromUID;
    }

    function validInviteBase(recipientUid, inviteId, data) {
      return validInviteIdentity(recipientUid, inviteId, data)
        && data.fromNickname is string
        && data.fromNickname.size() >= 1
        && data.fromNickname.size() <= 30
        && data.generation is int
        && data.generation >= 1
        && data.sentAt is timestamp;
    }

    function validPendingInvite(recipientUid, inviteId, data) {
      return data.keys().hasOnly([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt'
        ])
        && data.keys().hasAll([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt'
        ])
        && validInviteBase(recipientUid, inviteId, data)
        && data.status == 'pending';
    }

    function validRolledBackPendingInvite(recipientUid, inviteId, data) {
      return data.keys().hasOnly([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt', 'rolledBackClaimID'
        ])
        && data.keys().hasAll([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt', 'rolledBackClaimID'
        ])
        && validInviteBase(recipientUid, inviteId, data)
        && data.status == 'pending'
        && data.rolledBackClaimID is string
        && data.rolledBackClaimID.size() >= 1
        && data.rolledBackClaimID.size() <= 128;
    }

    function validAcceptingInvite(recipientUid, inviteId, data) {
      return data.keys().hasOnly([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt', 'acceptClaimID', 'acceptingAt'
        ])
        && data.keys().hasAll([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt', 'acceptClaimID', 'acceptingAt'
        ])
        && validInviteBase(recipientUid, inviteId, data)
        && data.status == 'accepting'
        && data.acceptClaimID is string
        && data.acceptClaimID.size() >= 1
        && data.acceptClaimID.size() <= 128
        && data.acceptingAt is timestamp;
    }

    function validAcceptedInvite(recipientUid, inviteId, data) {
      return data.keys().hasOnly([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt', 'acceptClaimID', 'acceptingAt',
          'acceptedAt'
        ])
        && data.keys().hasAll([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt', 'acceptClaimID', 'acceptingAt',
          'acceptedAt'
        ])
        && validInviteBase(recipientUid, inviteId, data)
        && data.status == 'accepted'
        && data.acceptClaimID is string
        && data.acceptClaimID.size() >= 1
        && data.acceptClaimID.size() <= 128
        && data.acceptingAt is timestamp
        && data.acceptedAt is timestamp;
    }

    function validCancelledInvite(recipientUid, inviteId, data) {
      return data.keys().hasOnly([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt'
        ])
        && data.keys().hasAll([
          'roomInstanceID', 'roomCode', 'fromUID', 'toUID', 'fromNickname',
          'status', 'generation', 'sentAt'
        ])
        && validInviteBase(recipientUid, inviteId, data)
        && data.status == 'cancelled';
    }

    function sameInviteGeneration() {
      return request.resource.data.roomInstanceID == resource.data.roomInstanceID
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.fromUID == resource.data.fromUID
        && request.resource.data.toUID == resource.data.toUID
        && request.resource.data.fromNickname == resource.data.fromNickname
        && request.resource.data.generation == resource.data.generation
        && request.resource.data.sentAt == resource.data.sentAt;
    }

    function recipientClaims(recipientUid, inviteId) {
      return isOwner(recipientUid)
        && resource.data.status == 'pending'
        && (validPendingInvite(recipientUid, inviteId, resource.data)
          || validRolledBackPendingInvite(recipientUid, inviteId, resource.data))
        && validAcceptingInvite(recipientUid, inviteId, request.resource.data)
        && sameInviteGeneration()
        && request.resource.data.acceptingAt == request.time
        && request.time < resource.data.sentAt + duration.value(30, 's')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptClaimID', 'acceptingAt', 'rolledBackClaimID'])
        && mutualFriends(resource.data.fromUID, recipientUid);
    }

    function recipientFinalizes(recipientUid, inviteId) {
      return isOwner(recipientUid)
        && resource.data.status == 'accepting'
        && validAcceptingInvite(recipientUid, inviteId, resource.data)
        && validAcceptedInvite(recipientUid, inviteId, request.resource.data)
        && sameInviteGeneration()
        && request.resource.data.acceptClaimID == resource.data.acceptClaimID
        && request.resource.data.acceptingAt == resource.data.acceptingAt
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt']);
    }

    function recipientRollsBack(recipientUid, inviteId) {
      return isOwner(recipientUid)
        && resource.data.status == 'accepting'
        && validAcceptingInvite(recipientUid, inviteId, resource.data)
        && request.resource.data.keys().hasAll(['rolledBackClaimID'])
        && request.resource.data.rolledBackClaimID == resource.data.acceptClaimID
        && validRolledBackPendingInvite(recipientUid, inviteId, request.resource.data)
        && sameInviteGeneration()
        && request.time < resource.data.sentAt + duration.value(30, 's')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptClaimID', 'acceptingAt', 'rolledBackClaimID']);
    }

    function recipientCancels(recipientUid, inviteId) {
      return isOwner(recipientUid)
        && resource.data.status == 'pending'
        && validPendingInvite(recipientUid, inviteId, resource.data)
        && validCancelledInvite(recipientUid, inviteId, request.resource.data)
        && sameInviteGeneration()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid) && validUserDocument(uid);
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/friendCodes/$(resource.data.friendCode));

      match /friends/{friendUid} {
        allow get: if isOwner(uid) || (signedIn() && request.auth.uid == friendUid);
        allow list: if isOwner(uid);
        allow create, update: if signedIn()
          && friendUid != uid
          && validFriendDocument(friendUid, request.resource.data)
          && (acceptsFriendRequest(uid, friendUid) || acceptsFriendRequest(friendUid, uid));
        allow delete: if (isOwner(uid)
            && (!exists(/databases/$(database)/documents/users/$(friendUid)/friends/$(uid))
              || removesMutualFriend(uid, friendUid)))
          || (signedIn() && request.auth.uid == friendUid && removesMutualFriend(friendUid, uid));
      }

      match /friendRequests/{senderUid} {
        allow get: if isOwner(uid) || (signedIn() && request.auth.uid == senderUid);
        allow list: if isOwner(uid);
        allow create: if signedIn()
          && request.auth.uid == senderUid
          && uid != senderUid
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.keys().hasOnly([
            'fromUID', 'fromNickname', 'fromFriendCode', 'createdAt'
          ])
          && request.resource.data.fromUID == senderUid
          && request.resource.data.fromNickname
            == get(/databases/$(database)/documents/users/$(senderUid)).data.nickname
          && request.resource.data.fromFriendCode
            == get(/databases/$(database)/documents/users/$(senderUid)).data.friendCode
          && request.resource.data.createdAt == request.time
          && (!exists(/databases/$(database)/documents/users/$(uid)/friends/$(senderUid))
            || !exists(/databases/$(database)/documents/users/$(senderUid)/friends/$(uid)))
          && !exists(/databases/$(database)/documents/users/$(senderUid)/friendRequests/$(uid))
          && existsAfter(/databases/$(database)/documents/users/$(senderUid)/sentFriendRequests/$(uid));
        allow delete: if removesFriendRequestPair(uid, senderUid);
        allow update: if false;
      }

      match /sentFriendRequests/{receiverUid} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid)
          && receiverUid != uid
          && exists(/databases/$(database)/documents/users/$(receiverUid))
          && request.resource.data.keys().hasOnly([
            'toUID', 'toNickname', 'toFriendCode', 'createdAt'
          ])
          && request.resource.data.toUID == receiverUid
          && request.resource.data.toNickname
            == get(/databases/$(database)/documents/users/$(receiverUid)).data.nickname
          && request.resource.data.toFriendCode
            == get(/databases/$(database)/documents/users/$(receiverUid)).data.friendCode
          && request.resource.data.createdAt == request.time
          && (!exists(/databases/$(database)/documents/users/$(uid)/friends/$(receiverUid))
            || !exists(/databases/$(database)/documents/users/$(receiverUid)/friends/$(uid)))
          && existsAfter(/databases/$(database)/documents/users/$(receiverUid)/friendRequests/$(uid));
        allow delete: if removesFriendRequestPair(receiverUid, uid);
        allow update: if false;
      }

      match /invites/{inviteId} {
        allow get: if isOwner(uid)
          || (signedIn()
            && inviteId.matches('^[A-Za-z0-9-]+_' + request.auth.uid + '$'));
        allow list: if isOwner(uid);
        // 作成・再招待はCloud FunctionだけがAdmin権限で行う。
        // clientからはhostを安全に検証できないため、sender本人でも直接writeを許可しない。
        allow create: if false;
        allow update: if isOwner(uid)
          && ((resource.data.status == 'pending'
              && (recipientClaims(uid, inviteId)
                || recipientCancels(uid, inviteId)))
            || (resource.data.status == 'accepting'
              && (recipientFinalizes(uid, inviteId)
                || recipientRollsBack(uid, inviteId))));
        allow delete: if false;
      }
    }

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validFriendCode(code)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.friendCode == code;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
