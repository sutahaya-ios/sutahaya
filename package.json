{
  "name": "hayaosiapp-firebase-rules-tests",
  "private": true,
  "scripts": {
    "test:firebase-rules": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-hayaosiapp --only firestore,database \"node --test FirebaseRulesTests/rules.test.js FirebaseRulesTests/questionAuthoring.test.js\"",
    "test:firebase-functions": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-hayaosiapp --only auth,firestore,database,functions \"node --test FirebaseFunctionsTests/sendRoomInvite.test.js\"",
    "test:competitive-core:unit": "node --test FirebaseFunctionsTests/competitiveCore.unit.test.js",
    "test:competitive-matchmaking:unit": "node --test FirebaseFunctionsTests/competitiveMatchmaking.unit.test.js",
    "test:competitive-rating:unit": "node --test FirebaseFunctionsTests/competitiveRating.unit.test.js",
    "test:competitive-npc:unit": "node --test FirebaseFunctionsTests/competitiveNPC.unit.test.js",
    "test:competitive-question-bank:unit": "node --test FirebaseFunctionsTests/competitiveQuestionBank.unit.test.js",
    "test:competitive-phase-d2:unit": "node --test FirebaseFunctionsTests/competitiveCore.unit.test.js FirebaseFunctionsTests/competitiveMatchmaking.unit.test.js FirebaseFunctionsTests/competitiveNPC.unit.test.js FirebaseFunctionsTests/competitiveRating.unit.test.js FirebaseFunctionsTests/competitiveQuestionBank.unit.test.js",
    "competitive:sync-question-bank": "node scripts/sync-competitive-question-bank.cjs --write",
    "competitive:check-question-bank": "node scripts/sync-competitive-question-bank.cjs --check",
    "test:competitive-core": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-hayaosiapp --only auth,database,functions \"node --test --test-force-exit FirebaseFunctionsTests/competitiveCore.test.js\"",
    "test:competitive-matchmaking": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-hayaosiapp --only auth,database,functions \"node --test --test-force-exit FirebaseFunctionsTests/competitiveMatchmaking.test.js\"",
    "test:competitive-phase-c": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-hayaosiapp --only auth,database,functions \"node --test --test-force-exit FirebaseFunctionsTests/competitivePhaseC.test.js\"",
    "test:competitive-phase-d1": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-hayaosiapp --only auth,database,functions \"node --test --test-force-exit FirebaseFunctionsTests/competitivePhaseD1.test.js\"",
    "test:competitive-phase-d2": "FIREBASE_CLI_DISABLE_UPDATE_CHECK=true firebase emulators:exec --project demo-hayaosiapp --only auth,database,functions \"node --test --test-force-exit FirebaseFunctionsTests/competitivePhaseD2.test.js\"",
    "test:competitive-cloud-e2e-driver": "node --test scripts/competitive-v2-cloud-e2e.test.js",
    "competitive:cloud-e2e:review": "node scripts/competitive-v2-cloud-e2e.cjs --review",
    "test:competitive-phase-b-cloud-e2e-driver": "node --test scripts/competitive-v2-phase-b-cloud-e2e.test.js",
    "competitive:phase-b-cloud-e2e:review": "node scripts/competitive-v2-phase-b-cloud-e2e.cjs --review"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.17.1",
    "firebase-tools": "15.26.0"
  }
}
