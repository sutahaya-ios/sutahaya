{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (!data.exists() || data.child('status').val() == 'waiting' || data.child('players').child(auth.uid).exists())",
        ".write": "auth != null && !data.exists() && newData.child('hostID').val() == auth.uid && newData.child('players').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['hostID', 'status', 'players']) && newData.child('hostID').isString() && newData.child('status').isString()",
        "hostID": {
          ".write": false,
          ".validate": "newData.isString() && ((!data.exists() && newData.val() == auth.uid) || newData.val() == data.val())"
        },
        "status": {
          ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostID').val()",
          ".validate": "newData.isString() && (newData.val() == 'waiting' || newData.val() == 'playing' || newData.val() == 'finished' || newData.val() == 'closed')"
        },
        "createdAt": {
          ".write": false,
          ".validate": "newData.isNumber()"
        },
        "settings": {
          ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostID').val()"
        },
        "questions": {
          ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostID').val()"
        },
        "game": {
          ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostID').val()",
          "answers": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($roomId).child('players').child(auth.uid).exists() && root.child('rooms').child($roomId).child('status').val() == 'playing' && root.child('rooms').child($roomId).child('game').child('phase').val() == 'question' && !data.exists()",
              ".validate": "newData.hasChildren(['questionIndex', 'choice', 'ts', 'visibleCount'])",
              "questionIndex": {
                ".validate": "newData.isNumber() && newData.val() == root.child('rooms').child($roomId).child('game').child('questionIndex').val()"
              },
              "choice": {
                ".validate": "newData.isString()"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "visibleCount": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "failed": {
            "$uid": {
              ".validate": "newData.hasChildren(['questionIndex'])",
              "questionIndex": {
                ".validate": "newData.isNumber() && newData.val() == root.child('rooms').child($roomId).child('game').child('questionIndex').val()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == root.child('rooms').child($roomId).child('hostID').val() || (auth.uid == $uid && ((!data.exists() && root.child('rooms').child($roomId).child('status').val() == 'waiting' && newData.child('nickname').isString() && newData.child('score').val() == 0 && newData.child('joinedAt').isNumber()) || (data.exists() && !newData.exists()))))",
            ".validate": "newData.hasChildren(['nickname', 'score', 'joinedAt']) && newData.child('nickname').isString() && newData.child('score').isNumber() && newData.child('joinedAt').isNumber()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
