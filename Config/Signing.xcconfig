// 共有の既定値はリリース用Bundle ID。開発者固有値は下で読み込むlocal.xcconfigだけで上書きする。
APP_BUNDLE_IDENTIFIER = com.n.HayaosiApp

// チームIDと、必要な場合だけ開発用Bundle IDを Config/local.xcconfig(git管理外)で与える。
// 用意していなくてもSimulatorビルドは通る(実機ビルド時だけ必要)。
// セットアップ: cp Config/local.xcconfig.sample Config/local.xcconfig
#include? "local.xcconfig"
