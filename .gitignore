# Xcode
*.xcodeproj/
xcuserdata/
DerivedData/
build/

# XcodeGenで.xcodeprojは再生成できるため管理外(xcodegen generateで生成)

# macOS
.DS_Store

# Firebase の設定ファイル(管理外)
# git では渡せないので、受け渡しはファイルを直接送る。手順は FIREBASE_SETUP.md §3
# add しても «ignored by one of your .gitignore files» となりステージに乗らない(エラーには見えない)
GoogleService-Info.plist

# 署名設定(開発者ごとに違うため管理外。local.xcconfig.sample をコピーして作る)
Config/local.xcconfig

# Claude Code ローカル設定
.claude/settings.local.json

# 単語データの作業用xlsx(管理外)。バイナリなので同時編集するとgitがマージできず、
# 一方の追加語が消える恐れがある。正はHayaosiApp/Resources/*.json(scripts/word_bank_to_json.pyで変換)。
# 受け渡しはファイルを直接送る
word_bank.xlsx

# Firebase Emulator / Node.js のローカル生成物
node_modules/
.firebase/
firebase-debug.log*
firestore-debug.log*
database-debug.log*
ui-debug.log*
